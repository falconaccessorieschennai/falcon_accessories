rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: returns true if the requesting user has the 'admin' role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    // - Owner (the user themselves) or admin can read
    // - User can create their own profile document (for signup)
    // - Only admin can update/delete other users
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Job cards collection
    // - Admin can read all job cards
    // - Employee can read only their own job cards (where createdBy == their uid)
    // - Any authenticated user can create a job card
    // - Owner or admin can update a job card
    // - Only admin can delete a job card
    match /jobCards/{jobCardId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null && isAdmin();
    }

    // Accessories collection
    // - Any authenticated user can read (needed for job card forms)
    // - Only admin can create, update, delete
    match /accessories/{accessoryId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Follow-ups collection
    // - Admin can read/write all
    // - Employee can read/write only their own (createdBy == uid)
    match /followUps/{followUpId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }
  }
}
